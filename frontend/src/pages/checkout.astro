---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="BgSupplementos | Confirmar compra">
  <main class="mx-auto min-h-screen max-w-4xl px-4 py-10 lg:px-8">
    <section class="rounded-3xl border border-emerald-100 bg-gradient-to-br from-emerald-50 via-white to-cyan-50 p-8 shadow-xl shadow-emerald-100/60">
      <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.22em] text-emerald-700">BgSupplementos</p>
          <h1 class="mt-2 text-3xl font-semibold tracking-tight text-slate-900">Confirmar compra</h1>
          <p class="mt-2 text-sm text-slate-600">Confirma os itens e finaliza o pedido.</p>
        </div>
        <a href="/" class="btn btn-outline btn-sm">Voltar aos produtos</a>
      </div>
    </section>

    <section class="mt-8 grid gap-6 lg:grid-cols-[1fr_300px]">
      <div class="rounded-3xl border border-emerald-100 bg-white p-5 shadow-lg shadow-emerald-100/40">
        <div id="status" class="alert border border-emerald-100 bg-white text-slate-700 shadow-sm">
          <span>A preparar confirmacao de compra...</span>
        </div>
        <div id="empty" class="mt-4 rounded-xl border border-dashed border-slate-300 p-4 text-sm text-slate-500">
          Carrinho vazio. Adiciona produtos na pagina inicial.
        </div>
        <ul id="cart-items" class="mt-4 space-y-3"></ul>
      </div>

      <aside class="rounded-3xl border border-cyan-100 bg-white p-5 shadow-lg shadow-cyan-100/50">
        <label class="text-xs font-semibold uppercase tracking-[0.14em] text-slate-600" for="payment-method">
          Metodo de pagamento
        </label>
        <select id="payment-method" class="select select-bordered mt-2 w-full">
          <option value="transfer_site">Transferencia no site</option>
          <option value="transfer_whatsapp">Transferencia por WhatsApp</option>
        </select>

        <div class="mt-4 flex items-center justify-between border-t border-slate-200 pt-3">
          <span class="text-sm text-slate-600">Total</span>
          <strong id="total" class="text-emerald-700">AOA 0,00</strong>
        </div>

        <button id="checkout-btn" class="btn btn-primary mt-4 w-full">Finalizar pedido</button>
        <button id="clear-btn" class="btn btn-ghost mt-2 w-full">Limpar carrinho</button>
        <div id="result" class="mt-3 text-sm text-slate-700"></div>
      </aside>
    </section>
  </main>

  <script>
    const API_URL = (import.meta.env.PUBLIC_API_URL || "http://localhost:8081/api/v1").replace(/\/$/, "");
    const CART_KEY = "bgs_cart";

    const statusEl = document.getElementById("status");
    const emptyEl = document.getElementById("empty");
    const cartItemsEl = document.getElementById("cart-items");
    const totalEl = document.getElementById("total");
    const resultEl = document.getElementById("result");
    const checkoutBtn = document.getElementById("checkout-btn");
    const clearBtn = document.getElementById("clear-btn");
    const paymentMethodEl = document.getElementById("payment-method");

    const formatAOA = (value) =>
      new Intl.NumberFormat("pt-AO", {
        style: "currency",
        currency: "AOA",
        maximumFractionDigits: 2,
      }).format(value || 0);

    const safeNumber = (value, fallback = 0) => {
      const n = Number(value);
      return Number.isFinite(n) ? n : fallback;
    };

    const setStatus = (message, tone = "info") => {
      statusEl.className = `alert border shadow-sm ${
        tone === "error" ? "border-red-200 bg-red-50 text-red-800" : "border-emerald-100 bg-white text-slate-700"
      }`;
      statusEl.innerHTML = `<span>${message}</span>`;
    };

    const readCart = () => {
      try {
        return JSON.parse(localStorage.getItem(CART_KEY) || "[]");
      } catch {
        return [];
      }
    };

    const writeCart = (items) => {
      localStorage.setItem(CART_KEY, JSON.stringify(items));
    };

    const renderCart = () => {
      const cart = readCart();
      cartItemsEl.replaceChildren();
      let total = 0;

      for (const item of cart) {
        const lineTotal = safeNumber(item.price_aoa) * safeNumber(item.quantity, 1);
        total += lineTotal;

        const li = document.createElement("li");
        li.className = "rounded-xl border border-slate-200 bg-slate-50 p-3";
        li.innerHTML = `
          <div class="flex items-start justify-between gap-3">
            <div>
              <p class="text-sm font-semibold text-slate-800">${item.name}</p>
              <p class="text-xs text-slate-500">${formatAOA(item.price_aoa)} por unidade</p>
            </div>
            <button class="btn btn-ghost btn-xs text-red-600" data-remove="${item.id}">remover</button>
          </div>
          <div class="mt-2 flex items-center justify-between">
            <input class="qty input input-bordered input-xs w-20" data-qty="${item.id}" type="number" min="1" max="5" value="${safeNumber(item.quantity, 1)}" />
            <strong class="text-sm text-slate-700">${formatAOA(lineTotal)}</strong>
          </div>
        `;
        cartItemsEl.appendChild(li);
      }

      emptyEl.style.display = cart.length === 0 ? "block" : "none";
      totalEl.textContent = formatAOA(total);

      cartItemsEl.querySelectorAll("[data-remove]").forEach((button) => {
        button.addEventListener("click", () => {
          const id = button.getAttribute("data-remove");
          const next = readCart().filter((item) => item.id !== id);
          writeCart(next);
          renderCart();
        });
      });

      cartItemsEl.querySelectorAll("[data-qty]").forEach((input) => {
        input.addEventListener("change", () => {
          const id = input.getAttribute("data-qty");
          const next = readCart().map((item) => {
            if (item.id !== id) return item;
            const stockLimit = Math.max(0, safeNumber(item.available_quantity, 0));
            const nextQty = Math.max(1, Math.min(5, stockLimit || 5, safeNumber(input.value, 1)));
            return { ...item, quantity: nextQty };
          });
          writeCart(next);
          renderCart();
        });
      });
    };

    const runCheckout = async () => {
      const cart = readCart();
      if (cart.length === 0) {
        setStatus("Carrinho vazio.", "error");
        return;
      }

      checkoutBtn.setAttribute("disabled", "true");
      resultEl.textContent = "";

      try {
        const payload = {
          items: cart.map((item) => ({
            product_id: item.id,
            quantity: safeNumber(item.quantity, 1),
          })),
          payment_method: paymentMethodEl.value || "transfer_site",
        };

        const response = await fetch(`${API_URL}/store/checkout`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });

        const data = await response.json().catch(() => ({}));
        if (!response.ok) {
          throw new Error(data.error || "Falha ao finalizar pedido.");
        }

        setStatus("Pedido criado. Estado: pending_payment.");
        const instructionsHtml = Array.isArray(data.instructions)
          ? data.instructions.map((step) => `<li>${step}</li>`).join("")
          : "";
        const bank = data.bank_details && typeof data.bank_details === "object" ? data.bank_details : {};
        const whatsappLink =
          typeof data.whatsapp_url === "string" && data.whatsapp_url.length > 0
            ? `<a class="btn btn-success btn-sm mt-3" href="${data.whatsapp_url}" target="_blank" rel="noopener noreferrer">Enviar comprovativo no WhatsApp</a>`
            : "";
        const emailLine =
          typeof data.email === "string" && data.email.length > 0
            ? `<p class="mt-2 text-slate-700">Email de apoio: <strong>${data.email}</strong></p>`
            : "";

        resultEl.innerHTML = `
          <div class="rounded-xl border border-emerald-200 bg-emerald-50 p-4">
            <p class="font-semibold text-emerald-800">Pedido criado: ${data.order_id || "-"}</p>
            <p class="mt-1 text-emerald-700">Total: ${formatAOA(data.total_aoa)}</p>
            <p class="mt-1 text-amber-700">Estado: ${data.status || "pending_payment"} (aguarda confirmacao do admin)</p>
            <div class="mt-3 rounded-lg bg-white/80 p-3 text-sm">
              <p class="font-semibold text-slate-800">Dados de transferencia</p>
              <p class="mt-1 text-slate-700">Banco: <strong>${bank.bank || "-"}</strong></p>
              <p class="text-slate-700">Conta: <strong>${bank.account_name || "-"}</strong></p>
              <p class="text-slate-700">IBAN: <strong>${bank.iban || "-"}</strong></p>
              ${emailLine}
              ${
                instructionsHtml
                  ? `<ul class="mt-2 list-disc space-y-1 pl-5 text-slate-700">${instructionsHtml}</ul>`
                  : ""
              }
              ${whatsappLink}
            </div>
          </div>
        `;
        writeCart([]);
        renderCart();
      } catch (error) {
        const message = error instanceof Error ? error.message : "Falha ao finalizar pedido.";
        setStatus(message, "error");
        resultEl.innerHTML = `<div class="rounded-xl border border-red-200 bg-red-50 p-3 text-red-700">${message}</div>`;
      } finally {
        checkoutBtn.removeAttribute("disabled");
      }
    };

    clearBtn.addEventListener("click", () => {
      writeCart([]);
      resultEl.textContent = "";
      setStatus("Carrinho limpo.");
      renderCart();
    });

    checkoutBtn.addEventListener("click", runCheckout);
    setStatus("Confirmacao de compra pronta.");
    renderCart();
  </script>
</MainLayout>
