---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="BgSupplementos | Produtos">
  <main class="mx-auto min-h-screen max-w-6xl px-4 py-10 lg:px-8">
    <section class="rounded-3xl border border-emerald-100 bg-gradient-to-br from-emerald-50 via-white to-cyan-50 p-8 shadow-xl shadow-emerald-100/60">
      <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.22em] text-emerald-700">BgSupplementos</p>
          <h1 class="mt-3 text-3xl font-semibold tracking-tight text-slate-900 md:text-4xl">Produtos Disponiveis</h1>
          <p class="mt-3 max-w-2xl text-sm text-slate-600 md:text-base">
            Seleciona os suplementos e segue para confirmar compra numa pagina separada.
          </p>
        </div>
        <div class="flex gap-2">
          <button id="refresh-btn" class="btn btn-success btn-outline btn-sm">Atualizar</button>
          <a href="/checkout" class="btn btn-primary btn-sm">Confirmar compra</a>
        </div>
      </div>
    </section>

    <section class="mt-8">
      <div id="status" class="alert border border-emerald-100 bg-white text-slate-700 shadow-sm">
        <span>A carregar suplementos...</span>
      </div>
      <div id="products-grid" class="mt-6 grid gap-5 md:grid-cols-2 xl:grid-cols-3"></div>
    </section>
  </main>

  <template id="product-card-template">
    <article class="card overflow-hidden border border-emerald-100 bg-white shadow-lg shadow-emerald-100/50">
      <figure class="relative h-48 bg-gradient-to-b from-emerald-50 via-lime-50 to-white">
        <img class="product-image h-full w-full object-cover" alt="" loading="lazy" />
        <span class="stock-badge badge absolute left-3 top-3 border-none"></span>
      </figure>
      <div class="card-body">
        <h2 class="product-name card-title text-lg text-slate-900"></h2>
        <p class="product-description text-sm text-slate-600"></p>
        <p class="product-price text-xl font-semibold text-emerald-700"></p>
        <p class="product-stock text-sm text-slate-500"></p>
        <div class="mt-2 flex items-center gap-2">
          <input class="buy-qty input input-bordered input-sm w-20" type="number" min="1" max="5" value="1" />
          <button class="add-btn btn btn-outline btn-success btn-sm flex-1">Adicionar</button>
          <button class="buy-btn btn btn-primary btn-sm flex-1">Comprar</button>
        </div>
      </div>
    </article>
  </template>

  <script>
    const API_URL = "http://localhost:8081/api/v1";
    const CART_KEY = "bgs_cart";

    const productsGrid = document.getElementById("products-grid");
    const statusEl = document.getElementById("status");
    const refreshBtn = document.getElementById("refresh-btn");
    const cardTemplate = document.getElementById("product-card-template");
    const fallbackImage = "/favicon.svg";

    const formatAOA = (value) =>
      new Intl.NumberFormat("pt-AO", {
        style: "currency",
        currency: "AOA",
        maximumFractionDigits: 2,
      }).format(value || 0);

    const setStatus = (message, tone = "info") => {
      if (!statusEl) return;
      statusEl.className = `alert mt-0 border shadow-sm ${
        tone === "error" ? "border-red-200 bg-red-50 text-red-800" : "border-emerald-100 bg-white text-slate-700"
      }`;
      statusEl.innerHTML = `<span>${message}</span>`;
    };

    const safeNumber = (value, fallback = 0) => {
      const n = Number(value);
      return Number.isFinite(n) ? n : fallback;
    };

    const readCart = () => {
      try {
        return JSON.parse(localStorage.getItem(CART_KEY) || "[]");
      } catch {
        return [];
      }
    };

    const writeCart = (items) => {
      localStorage.setItem(CART_KEY, JSON.stringify(items));
    };

    const addToCart = (product, quantity) => {
      const qty = Math.max(1, Math.min(5, safeNumber(quantity, 1)));
      const stockLimit = Math.max(0, safeNumber(product.available_quantity));
      const cart = readCart();
      const existing = cart.find((item) => item.id === product.id);

      if (existing) {
        existing.quantity = Math.min(5, stockLimit, safeNumber(existing.quantity) + qty);
      } else {
        cart.push({
          id: product.id,
          name: product.name,
          image_path: product.image_path,
          price_aoa: safeNumber(product.price_aoa),
          in_stock: !!product.in_stock,
          available_quantity: safeNumber(product.available_quantity),
          quantity: Math.min(5, stockLimit, qty),
        });
      }

      writeCart(cart);
    };

    const createCard = (product) => {
      const fragment = cardTemplate.content.cloneNode(true);
      const image = fragment.querySelector(".product-image");
      const stockBadge = fragment.querySelector(".stock-badge");
      const name = fragment.querySelector(".product-name");
      const description = fragment.querySelector(".product-description");
      const price = fragment.querySelector(".product-price");
      const stock = fragment.querySelector(".product-stock");
      const qtyInput = fragment.querySelector(".buy-qty");
      const addButton = fragment.querySelector(".add-btn");
      const buyButton = fragment.querySelector(".buy-btn");

      image.src = product.image_path || fallbackImage;
      image.alt = product.name || "Suplemento";
      name.textContent = product.name || "Sem nome";
      description.textContent = product.description || "";
      price.textContent = formatAOA(product.price_aoa);
      stock.textContent = `${safeNumber(product.available_quantity)} unidades`;

      if (product.in_stock) {
        stockBadge.textContent = "Em stock";
        stockBadge.className = "stock-badge badge badge-success";
      } else {
        stockBadge.textContent = "Esgotado";
        stockBadge.className = "stock-badge badge badge-error";
      }

      const handleAdd = () => {
        const requested = Math.max(1, Math.min(5, safeNumber(qtyInput.value, 1)));
        const stockLimit = Math.max(0, safeNumber(product.available_quantity));
        if (!product.in_stock || stockLimit < 1) {
          setStatus("Produto sem stock.", "error");
          return false;
        }
        addToCart(product, requested);
        setStatus(`${product.name} adicionado ao carrinho.`);
        return true;
      };

      addButton.addEventListener("click", handleAdd);
      buyButton.addEventListener("click", () => {
        if (!handleAdd()) return;
        window.location.href = "/checkout";
      });

      if (!product.in_stock) {
        qtyInput.setAttribute("disabled", "true");
        addButton.setAttribute("disabled", "true");
        buyButton.setAttribute("disabled", "true");
      }

      return fragment;
    };

    const loadProducts = async () => {
      setStatus("A carregar suplementos...");
      refreshBtn?.setAttribute("disabled", "true");

      try {
        const response = await fetch(`${API_URL}/store/products`);
        const data = await response.json().catch(() => []);
        if (!response.ok) {
          throw new Error(data.error || "Falha ao carregar produtos.");
        }

        const products = Array.isArray(data) ? data : [];
        productsGrid?.replaceChildren();

        if (products.length === 0) {
          setStatus("Sem produtos disponiveis.");
          return;
        }

        for (const product of products) {
          productsGrid?.appendChild(createCard(product));
        }

        setStatus(`${products.length} produtos carregados.`);
      } catch (error) {
        setStatus(error instanceof Error ? error.message : "Falha ao carregar produtos.", "error");
      } finally {
        refreshBtn?.removeAttribute("disabled");
      }
    };

    refreshBtn?.addEventListener("click", loadProducts);
    loadProducts();
  </script>
</MainLayout>
