---
import "../styles/global.css";

interface Props {
  title?: string;
  theme?: string;
}

const { title = "BgSupplementos", theme = "light" } = Astro.props;
---

<html lang="en" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="text-slate-800">
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href="/">
          <span class="brand-mark">BG</span>
          <span>
            <strong>BgSupplementos</strong>
            <small>Saude e suplementos</small>
          </span>
        </a>
        <nav class="site-nav" aria-label="Navegacao principal">
          <a href="/">Inicio</a>
          <a href="/checkout">Confirmar compra</a>
        </nav>
      </header>

      <slot />

      <footer class="site-footer">
        <p>&copy; 2026 BgSupplementos</p>
        <p>
          <a href="https://wa.me/244938252431" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 font-semibold text-emerald-700">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              width="18"
              height="18"
              fill="currentColor"
              aria-hidden="true"
            >
